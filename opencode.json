{
  "$schema": "https://opencode.ai/config.json",
  "model": "byteplus-plan/deepseek-v4.1-flash",
  "provider": {
    "byteplus-plan": {
      "npm": "@ai-sdk/openai",
      "name": "BytePlus ModelArk (Coding Plan)",
      "options": {
        "baseURL": "https://ark.ap-southeast.bytepluses.com/api/coding/v3",
        "apiKey": "{file:~/.secrets/byteplus-key}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": {
            "context": 1024000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
