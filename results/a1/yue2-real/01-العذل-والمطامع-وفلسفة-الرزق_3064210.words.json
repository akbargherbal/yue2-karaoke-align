  "lines": [
    {
      "i": 0,
      "text": "لَا تَعْذُلِيهِ فَإِنَّ الْعَذْلَ يُولِعُهُ"
    },
    {
      "i": 1,
      "text": "قَدْ قُلْتِ حَقًّا وَلَـٰكِنْ لَيْسَ يَسْمَعُهُ..."
    },
    {
      "i": 2,
      "text": "لَا تَعْذُلِيهِ فَإِنَّ الْعَذْلَ يُولِعُهُ"
    },
    {
      "i": 3,
      "text": "قَدْ قُلْتِ حَقًّا وَلَـٰكِنْ لَيْسَ يَسْمَعُهُ..."
    },
    {
      "i": 4,
      "text": "جَاوَزْتِ فِي لَوْمِهِ حَدًّا أَضَرَّ بِهِ"
    },
    {
      "i": 5,
      "text": "مِنْ حَيْثُ قَدَّرْتِ أَنَّ ٱلَّوۡمَ يَنْفَعُهُ..."
    },
    {
      "i": 6,
      "text": "(فَاسْتَعْمِلِي الرِّفْقَ) فِي تَأْنِيبِهِ بَدَلًا مِنْ عَذْلِهِ"
    },
    {
      "i": 7,
      "text": "فَهُوَ مُضْنَى الْقَلْبِ مُوجَعُهُ..."
    },
    {
      "i": 8,
      "text": "قَدْ كَانَ مُضْطَلِعًا بِالْخَطْبِ يَحْمِلُهُ"
    },
    {
      "i": 9,
      "text": "فَضُلِّعَتْ بِخُطُوبِ الْبَيْنِ أَضْلُعُهُ..."
    },
    {
      "i": 10,
      "text": "يَكْفِيهِ مِنْ لَوْعَةِ التَّشْتِيتِ (أَنَّ لَهُ)"
    },
    {
      "i": 11,
      "text": "مِنَ النَّوَى كُلَّ يَوْمٍ مَا يُرَوِّعُهُ..."
    },
    {
      "i": 12,
      "text": "مَا آبَ مِنْ سَفَرٍ إِلَّا وَأَزْعَجَهُ"
    },
    {
      "i": 13,
      "text": "رَأْيٌ إِلَى سَفَرٍ بِالرَّغْمِ يَزْمَعُهُ..."
    },
    {
      "i": 14,
      "text": "كَأَنَّمَا هُوَ فِي حِلٍّ وَمُرْتَحَلٍ"
    },
    {
      "i": 15,
      "text": "مُوَكَّلٌ بِفَضَاءِ اللَّهِ يَذْرَعُهُ..."
    },
    {
      "i": 16,
      "text": "إِنَّ الزَّمَانَ أَرَاهُ فِي الرَّحِيلِ غِنًى"
    },
    {
      "i": 17,
      "text": "وَلَوْ إِلَى السِّنْدِ أَضْحَى وَهْوَ يَزْمَعُهُ..."
    },
    {
      "i": 18,
      "text": "تَأْبَى الْمَطَامِعُ إِلَّا أَنْ تُجَشِّمَهُ"
    },
    {
      "i": 19,
      "text": "لِلرِّزْقِ كَدًّا وَكَمْ مِمَّنْ يُوَدِّعُهُ..."
    },
    {
      "i": 20,
      "text": "وَمَا مُجَاهَدَةُ الْإِنْسَانِ تُوصِلُهُ رِزْقًا"
    },
    {
      "i": 21,
      "text": "وَلَا دَعَةُ الْإِنْسَانِ تَقْطَعُهُ..."
    },
    {
      "i": 22,
      "text": "(قَدْ وَزَّعَ اللَّهُ بَيْنَ الْخَلْقِ رِزْقَهُمُ)"
    },
    {
      "i": 23,
      "text": "لَمْ يَخْلُقِ اللَّهُ مِنْ خَلْقٍ يُضَيِّعُهُ..."
    },
    {
      "i": 24,
      "text": "لَـٰكِنَّهُمْ كُلِّفُوا حِرْصًا فَلَسْتَ تَرَى مُسْتَرْزِقًا"
    },
    {
      "i": 25,
      "text": "وَسِوَى الْغَايَاتِ تُقْنِعُهُ..."
    },
    {
      "i": 26,
      "text": "وَالْحِرْصُ فِي الرِّزْقِ وَالْأَرْزَاقُ قَدْ قُسِمَتْ بَغْيٌ"
    },
    {
      "i": 27,
      "text": "(أَلَا) إِنَّ بَغْيَ الْمَرْءِ يَصْرَعُهُ..."
    },
    {
      "i": 28,
      "text": "وَالدَّهْرُ يُعْطِي الْفَتَى مِنْ حَيْثُ يَمْنَعُهُ"
    },
    {
      "i": 29,
      "text": "إِرْثًا وَيَمْنَعُهُ مِنْ حَيْثُ يُطْمِعُهُ..."
    },
    {
      "i": 30,
      "text": "وَالدَّهْرُ يُعْطِي الْفَتَى مِنْ حَيْثُ يَمْنَعُهُ"
    },
    {
      "i": 31,
      "text": "إِرْثًا وَيَمْنَعُهُ مِنْ حَيْثُ يُطْمِعُهُ..."
    }
