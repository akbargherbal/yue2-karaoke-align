  "lines": [
    {
      "i": 0,
      "text": "اعْتَضْتُ مِنْ وَجْهِ خِلِّي بَعْدَ فُرْقَتِهِ كَأْسًا"
    },
    {
      "i": 1,
      "text": "يُجَرَّعُ مِنْهَا مَا أُجَرَّعُهُ..."
    },
    {
      "i": 2,
      "text": "اعْتَضْتُ مِنْ وَجْهِ خِلِّي بَعْدَ فُرْقَتِهِ كَأْسًا"
    },
    {
      "i": 3,
      "text": "يُجَرَّعُ مِنْهَا مَا أُجَرَّعُهُ..."
    },
    {
      "i": 4,
      "text": "كَمْ قَائِلٍ لِي ذُقْتَ الْبَيْنَ قُلْتُ لَهُ"
    },
    {
      "i": 5,
      "text": "الذَّنْبُ وَاللَّهِ ذَنْبِي لَسْتُ أَدْفَعُهُ..."
    },
    {
      "i": 6,
      "text": "(أَلَا أَقَمْتَ) فَكَانَ الرُّشْدُ أَجْمَعُهُ"
    },
    {
      "i": 7,
      "text": "لَوْ أَنَّنِي يَوْمَ بَانَ الرُّشْدُ أَتْبَعُهُ..."
    },
    {
      "i": 8,
      "text": "لَوْ أَنَّنِي لَمْ تَقَعْ عَيْنِي عَلَى بَلَدٍ"
    },
    {
      "i": 9,
      "text": "فِي سَفْرَتِي هَـٰذِهِ إِلَّا وَأَقْطَعُهُ..."
    },
    {
      "i": 10,
      "text": "إِنِّي لَأَقْطَعُ أَيَّامِي وَأُنْفِدُهَا"
    },
    {
      "i": 11,
      "text": "بِحَسْرَةٍ مِنْهُ فِي قَلْبِي تُقَطِّعُهُ..."
    },
    {
      "i": 12,
      "text": "مَا كُنْتُ أَحْسَبُ أَنَّ الدَّهْرَ يَفْجَعُنِي بِهِ"
    },
    {
      "i": 13,
      "text": "وَلَا أَنَّ بِي الْأَيَّامَ تَفْجَعُهُ..."
    },
    {
      "i": 14,
      "text": "بِمَنْ إِذَا هَجَعَ النُّوَّامُ بِتُّ لَهُ"
    },
    {
      "i": 15,
      "text": "بِلَوْعَةٍ مِنْهُ لَيْلِي لَسْتُ أَهْجَعُهُ..."
    },
    {
      "i": 16,
      "text": "لَا يَطْمَئِنُّ لِجَنْبِي مَضْجَعٌ وَكَذَا"
    },
    {
      "i": 17,
      "text": "لَا يَطْمَئِنُّ لَهُ مُذْ بِنْتُ مَضْجَعُهُ..."
    },
    {
      "i": 18,
      "text": "حَتَّى جَرَى الْبَيْنُ فِيمَا بَيْنَنَا بِيَدٍ عَسْرَاءَ"
    },
    {
      "i": 19,
      "text": "(تَمْنَعُنِي حَظِّي) وَتَمْنَعُهُ..."
    },
    {
      "i": 20,
      "text": "قَدْ كُنْتُ مِنْ رَيْبِ دَهْرِي جَازِعًا فَرِقًا"
    },
    {
      "i": 21,
      "text": "فَلَمْ أُوَقَّ ٱلَّذِي قَدْ كُنْتُ أَجْزَعُهُ..."
    },
    {
      "i": 22,
