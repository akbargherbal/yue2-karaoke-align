  "lines": [
    {
      "i": 0,
      "text": "فَإِنْ تَبْتَئِسْ بِالشَّنْفَرَى أُمُّ قَسْطَلٍ"
    },
    {
      "i": 1,
      "text": "لَمَا اغْتَبَطَتْ بِالشَّنْفَرَى قَبْلُ أَطْوَلُ..."
    },
    {
      "i": 2,
      "text": "فَإِنْ تَبْتَئِسْ بِالشَّنْفَرَى أُمُّ قَسْطَلٍ"
    },
    {
      "i": 3,
      "text": "لَمَا اغْتَبَطَتْ بِالشَّنْفَرَى قَبْلُ أَطْوَلُ..."
    },
    {
      "i": 4,
      "text": "طَرِيدُ جِنَايَاتٍ تَيَاسَرْنَ لَحْمَهُ"
    },
    {
      "i": 5,
      "text": "عَقِيرَتُهُ لِأَيِّهَا حُمَّ أَوَّلُ..."
    },
    {
      "i": 6,
      "text": "تَنَامُ إِذَا مَا نَامَ يَقْظَى عُيُونُهَا"
    },
    {
      "i": 7,
      "text": "حِثَاثًا إِلَى مَكْرُوهِهِ تَتَغَلْغَلُ..."
    },
    {
      "i": 8,
      "text": "وَإِلْفُ هُمُومٍ مَا تَزَالُ تَعُودُهُ"
    },
    {
      "i": 9,
      "text": "عِيَادًا كَحُمَّى الرِّبْعِ أَوْ هِيَ أَثْقَلُ..."
    },
    {
      "i": 10,
      "text": "إِذَا وَرَدَتْ أَصْدَرْتُهَا ثُمَّ إِنَّهَا"
    },
    {
      "i": 11,
      "text": "تَثُوبُ فَتَأْتِي مِنْ تُحَيْتُ وَمِنْ عَلُ..."
    },
    {
      "i": 12,
      "text": "فَإِمَّا تَرَيْنِي كَابْنَةِ الرَّمْلِ ضَاحِيًا"
    },
    {
      "i": 13,
      "text": "عَلَى رِقَّةٍ أَحْفَى وَلَا أَتَنَعَّلُ..."
    },
    {
      "i": 14,
      "text": "فَإِنِّي لَمَوْلَى الصَّبْرِ أَجْتَابُ بَزَّهُ"
    },
    {
      "i": 15,
      "text": "عَلَى مِثْلِ قَلْبِ السِّمْعِ وَالْحَزْمَ أَفْعَلُ..."
    },
    {
      "i": 16,
      "text": "وَأُعْدَمُ أَحْيَانًا وَأَغْنَى وَإِنَّمَا"
    },
    {
      "i": 17,
      "text": "يَنَالُ الْغِنَى ذُو الْبُعْدَةِ الْمُتَبَذِّلُ..."
    },
    {
      "i": 18,
      "text": "فَلَا جَزِعٌ مِنْ خَلَّةٍ مُتَكَشِّفٌ"
    },
    {
      "i": 19,
      "text": "وَلَا مَرِحٌ تَحْتَ الْغِنَى أَتَخَيَّلُ..."
    },
    {
      "i": 20,
      "text": "وَلَا تَزْدَهِي الْأَجْهَالُ حِلْمِي وَلَا أُرَى"
    },
    {
      "i": 21,
      "text": "سَؤُولًا بِأَعْقَابِ الْأَقَاوِيلِ أُنْمِلُ..."
    },
    {
      "i": 22,
      "text": "وَلَا تَزْدَهِي الْأَجْهَالُ حِلْمِي وَلَا أُرَى"
    },
