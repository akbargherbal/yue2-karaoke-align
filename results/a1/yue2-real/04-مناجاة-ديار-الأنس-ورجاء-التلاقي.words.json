  "lines": [
    {
      "i": 0,
      "text": "بِاللَّهِ يَا مَنْزِلَ الْعَيْشِ ٱلَّذِي دَرَسَتْ آثَارُهُ"
    },
    {
      "i": 1,
      "text": "وَعَفَتْ مُذْ بِنْتُ أَرْبُعُهُ..."
    },
    {
      "i": 2,
      "text": "بِاللَّهِ يَا مَنْزِلَ الْعَيْشِ ٱلَّذِي دَرَسَتْ آثَارُهُ"
    },
    {
      "i": 3,
      "text": "وَعَفَتْ مُذْ بِنْتُ أَرْبُعُهُ..."
    },
    {
      "i": 4,
      "text": "(هَلِ الزَّمَانُ مُعِيدٌ فِيكَ لَذَّتَنَا)"
    },
    {
      "i": 5,
      "text": "أَمِ ٱلَّيَالِي ٱلَّتِي أَمْضَتْهُ تُرْجِعُهُ..."
    },
    {
      "i": 6,
      "text": "فِي ذِمَّةِ اللَّهِ مَنْ أَصْبَحْتَ مَنْزِلَهُ"
    },
    {
      "i": 7,
      "text": "وَجَادَ غَيْثٌ عَلَى مَغْنَاكَ يُمْرِعُهُ..."
    },
    {
      "i": 8,
      "text": "مَنْ عِنْدَهُ لِيَ عَهْدٌ لَا يُضَيِّعُهُ"
    },
    {
      "i": 9,
      "text": "كَمَا لَهُ عَهْدُ صِدْقٍ لَا أُضَيِّعُهُ..."
    },
    {
      "i": 10,
      "text": "عَسَى ٱلَّيَالِي ٱلَّتِي أَضْنَتْ بِفُرْقَتِنَا جِسْمِي"
    },
    {
      "i": 11,
      "text": "(سَتَجْمَعُنِي) يَوْمًا وَتَجْمَعُهُ..."
    },
    {
      "i": 12,
      "text": "وَمَنْ يُصَدِّعُ قَلْبِي ذِكْرُهُ (وَإِذَا جَرَى)"
    },
    {
      "i": 13,
      "text": "عَلَى قَلْبِهِ ذِكْرِي يُصَدِّعُهُ..."
    },
    {
      "i": 14,
      "text": "لَأَصْبِرَنَّ لِدَهْرٍ لَا يُمَتِّعُنِي بِهِ"
    },
    {
      "i": 15,
      "text": "وَلَا بِيَ فِي حَالٍ يُمَتِّعُهُ..."
    },
    {
      "i": 16,
      "text": "عِلْمًا بِأَنَّ اصْطِبَارِي مُعْقِبٌ فَرَجًا"
    },
    {
      "i": 17,
      "text": "(فَأَضْيَقُ الْأَمْرِ) إِنْ فَكَّرْتَ أَوْسَعُهُ..."
    },
    {
      "i": 18,
      "text": "وَإِنْ تُغِلَّ أَحَدًا مِنَّا مَنِيَّتُهُ"
    },
    {
      "i": 19,
      "text": "لَا بُدَّ فِي غَدِهِ الثَّانِي سَيَتْبَعُهُ..."
    },
    {
      "i": 20,
      "text": "عَسَى ٱلَّيَالِي ٱلَّتِي أَضْنَتْ بِفُرْقَتِنَا جِسْمِي"
    },
    {
      "i": 21,
      "text": "(سَتَجْمَعُنِي) يَوْمًا وَتَجْمَعُهُ..."
    },
    {
      "i": 22,
      "text": "وَإِنْ تُغِلَّ أَحَدًا مِنَّا مَنِيَّتُهُ"
