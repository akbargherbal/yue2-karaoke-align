    {
      "i": 2,
      "text": "أَسْتَوْدِعُ اللَّهَ فِي بَغْدَادَ لِي قَمَرًا"
    },
    {
      "i": 3,
      "text": "بِالْكَرْخِ مِنْ فَلَكِ الْأَزْرَارِ مَطْلَعُهُ..."
    },
    {
      "i": 4,
      "text": "وَدَّعْتُهُ وَبِوُدِّي (لَوْ يُوَدِّعُنِي)"
    },
    {
      "i": 5,
      "text": "صَفْوَ الْحَيَاةِ وَأَنِّي لَا أُوَدِّعُهُ..."
    },
    {
      "i": 6,
      "text": "وَكَمْ تَشَفَّعَ بِي أَنْ لَا أُفَارِقَهُ"
    },
    {
      "i": 7,
      "text": "وَلِلضَّرُورَاتِ حَالٌ لَا تُشَفِّعُهُ..."
    },
    {
      "i": 8,
      "text": "وَكَمْ تَشَبَّثَ بِي يَوْمَ الرَّحِيلِ ضُحًى"
    },
    {
      "i": 9,
      "text": "(وَأَدْمُعِي مُسْتَهِلَّاتٌ) وَأَدْمُعُهُ..."
    },
    {
      "i": 10,
      "text": "أَسْتَوْدِعُ اللَّهَ فِي بَغْدَادَ لِي قَمَرًا"
    },
    {
      "i": 11,
      "text": "بِالْكَرْخِ مِنْ فَلَكِ الْأَزْرَارِ مَطْلَعُهُ..."
    },
    {
      "i": 12,
      "text": "(لَا أَكْذِبُ اللَّهَ) ثَوْبُ الصَّبْرِ مُنْخَرِقٌ عَنِّي"
    },
    {
      "i": 13,
